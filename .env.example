# Copy to .env and fill in. Never commit .env.

# --- LLM: pick one provider (both are OpenAI-compatible) ---
# "litellm" = neatHack's shared key (Nova + Claude, $20 budget)
# "tokenrouter" = your own router key
LLM_PROVIDER=litellm

LITELLM_API_KEY=
LITELLM_BASE_URL=https://litellm.vision.aivar.app/v1

TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=

# Model names per role (defaults match the LiteLLM key; change if using TokenRouter)
MODEL_CHEAP=claude-haiku
MODEL_VISION=nova-lite
MODEL_STRONG=claude-sonnet-4.6

# --- neatlogs (required) ---
NEATLOGS_API_KEY=

# --- Research: real company data ---
CRUSTDATA_API_KEY=
SEC_USER_AGENT=            # required by SEC EDGAR: "Munshi <contact-email>"
COMPANIES_HOUSE_API_KEY=

# --- Dodo Payments (test mode) ---
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
